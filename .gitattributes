# Normalise line endings: LF in the repo, regardless of who commits from where.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs.
web/package-lock.json -diff linguist-generated
web/src/payload-types.ts linguist-generated
web/src/app/(payload)/admin/importMap.js linguist-generated
